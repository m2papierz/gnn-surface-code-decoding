# Ignore all files in this directory
*

# excluding this file
!.gitignore

# Every artifact tree is partitioned by operation at its root, so each pattern
# carries one <operation>/ level.

# committed circuit files with the manifests that identify them
!circuits/
!circuits/*/
!circuits/*/*.stim
!circuits/*/*.json

# committed CI shard
!ci_shard/
!ci_shard/*/
!ci_shard/*/*.npy
!ci_shard/*/*.json

# committed eval sets
!eval/
!eval/*/
!eval/*/*/
!eval/*/*/*.npz
!eval/*/*/*.json
